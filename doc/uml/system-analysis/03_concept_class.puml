@startuml
!include ../_style.inc.puml
title 图3-2 系统概念类图（面向对象系统分析——对象、属性与方法）

skinparam linetype ortho
skinparam nodesep 22
skinparam ranksep 52
left to right direction

package "人员与权限域" {
  class 用户 {
    - userId : Long
    - 学工号 / 姓名 / 手机号
    - 信用分 : int
    - 微信openid / 绑定时间
    - 状态 : String
    + 登录() : Token
    + 绑定微信() : Result
    + 校验预约资格() : boolean
  }
  class 角色 {
    - roleId : Long
    - 角色编码 / 角色名称
    + 校验权限(权限编码) : boolean
  }
  class 权限 {
    - permId : Long
    - 权限编码 / 权限名称
  }
  class 信用记录 {
    - recordId : Long
    - 变动类型 / 变动分值
    - 变动前后余额
    - 发生时间 : DateTime
    + 追加扣分() : void
    + 追加恢复() : void
  }
}

package "资源域" {
  class 实验室 {
    - labId : Long
    - 编号 / 名称 / 位置
    - 容量 : int
    - 状态 : String
    + 是否开放(时间) : boolean
    + 查询可用工位(时段) : List
  }
  class 工位 {
    - seatId : Long
    - 实验室ID / 工位编号
    - 区域 / 实验室内序号
    - 配置等级 / 靠窗标记 / 状态
    + 是否满足硬配置(请求) : boolean
    + 是否满足软偏好(请求) : boolean
  }
  class 设备 {
    - deviceId : Long
    - 设备类型 / 所属实验室
    - 终端编码 / 终端密钥哈希
    - 状态 : String
    + 是否可用() : boolean
    + 验证签到终端(终端凭证) : boolean
  }
  class 开放时间规则 {
    - ruleId : Long
    - 生效星期 / 起止时间
    - 可空规则覆盖项
    + 覆盖时间片() : long
    + 计算有效规则(全局配置) : Rule
  }
  class 实验室时段位图 {
    - bitmapId : Long
    - 实验室ID / 日期
    - 掩码 : long
    - 版本号 : int
    + 检测整室冲突(申请掩码) : boolean
    + 占用(申请掩码) : void
    + 释放(目标掩码) : void
  }
  class 工位时段位图 {
    - bitmapId : Long
    - 工位ID / 日期
    - 掩码 : long
    - 版本号 : int
    + 检测工位冲突(申请掩码) : boolean
    + 占用(申请掩码) : void
    + 释放(目标掩码) : void
  }
}

package "预约与排期域" {
  class 批量申请 {
    - batchId : Long
    - 批次号 / 课程名称
    - 申请人 / 实验室
    + 添加明细() : void
    + 提交() : Result
    + 汇总结果() : Result
  }
  class 预约申请 {
    - resvId : Long
    - 分配模式 : AllocationMode
    - 预约粒度 : ReservationMode
    - 起止时间 / 人数 / 用途
    - 签到签退时间 / 签到渠道
    - 状态 : String
    + 校验参数() : Result
    + 提交() : Result
    + 取消(原因) : Result
    + 签到(渠道, 凭证) : Result
    + 签退(时间) : Result
  }
  class 座位分配 {
    - id : Long
    - 预约ID / 工位ID
    - 时间掩码 : long
    - 分配方式
    + 调整(新工位) : void
    + 释放(剩余掩码) : void
  }
  class 违规记录 {
    - violationId : Long
    - 类型 / 扣分 / 状态
    - 登记时间
    + 登记() : void
    + 撤销() : void
  }
  class 申诉 {
    - appealId : Long
    - 违规ID / 申请人
    - 理由 / 状态 / 核定意见
    + 提交() : Result
    + 核定(意见) : Result
  }
  class 排期任务 {
    - taskId : Long
    - 排期批次号 / 算法类型
    - 主任务标记
    - 需求与资源快照
    - 参数 / 随机种子 / 重复序号
    - 状态 / 进度
    + 执行() : void
    + 上报进度() : void
    + 发布主方案() : Result
  }
  class 排期结果 {
    - resultId : Long
    - 任务ID / 申请ID
    - 分配实验室 / 起止时间
    - 候选工位分配
    - 发布标记 / 发布时间
    + 重新校验() : Result
    + 发布() : Result
  }
  class 统计指标 {
    - metricId : Long
    - 日期 / 实验室ID
    - 计划利用率 / 实际利用率
    - 爽约率
    + 计算热力图() : Map
    + 导出报表() : File
  }
}

package "系统支撑域" {
  class 算法实验 {
    - expId : Long
    - 任务ID / 数据规模
    - 五项评价指标
    - 分阶段耗时
    + 运行() : void
    + 对比() : List
  }
  class 冲突检测器 <<service>> {
    + 区间检测(申请, 区间列表) : boolean
    + 位图检测(申请掩码, 占用掩码) : boolean
    + 双向检测(申请, 资源快照) : Result
  }
  class 排期引擎 <<service>> {
    + 先到先得(需求, 快照) : 排期结果
    + 贪心排期(需求, 快照, 权重) : 排期结果
    + 遗传排期(需求, 快照, 参数) : 排期结果
  }
  class 适应度评估器 <<service>> {
    + 预计分配成功率(染色体) : double
    + 预计资源利用率(染色体) : double
    + 时间碎片率(染色体) : double
    + 约束违反惩罚(染色体) : double
  }
  class 评价器 <<service>> {
    + 分配成功率(最终结果) : double
    + 平均工位利用率(最终结果) : double
    + 工位偏好错配率(最终结果) : double
    + 时间碎片率(最终结果) : double
    + 两阶段耗时(任务) : Metric
  }
  class 账号认证服务 <<service>> {
    + 验证密码(学号, 密码) : Result
    + 绑定微信(临时凭证, 学号, 密码) : Result
    + 验证终端(终端会话) : Result
  }
  class 签到服务 <<service>> {
    + 扫码签到(用户, 二维码, 预约) : Result
    + 终端签到(终端, 学号, 密码, 预约) : Result
    + 生成短期选择凭证(预约列表) : Token
    + 签退(预约) : Result
  }
  class 智能助手服务 <<service>> {
    - 模型配置 / 提示词版本
    - 白名单工具集合
    + 问答(用户, 线程, 消息) : Answer
    + 流式问答(用户, 线程, 消息) : AsyncIterator
    + 生成预约草稿(消息, 工具事实) : ReservationDraft
  }
  class 对话线程 {
    - threadId : String
    - 用户ID : Long
    - 消息列表 : List
    - 过期时间 : DateTime
    + 加载历史() : List
    + 追加消息(消息) : void
    + 裁剪历史(最大条数) : void
  }
  class 预约草稿 {
    - 实验室ID / 日期时段
    - 分配模式 : FIXED
    - 预约粒度 / 工位数量
    - 偏好 : Json
    + 校验结构() : Result
    + 回填表单() : Form
  }
  class 只读工具集 <<service>> {
    + 查询预约规则(实验室ID) : Result
    + 查询空闲情况(实验室ID, 日期, 粒度) : Result
    + 查询本人预约(用户ID, 状态) : Result
  }
}

用户 "1" -- "0..*" 角色
角色 "1" -- "0..*" 权限
用户 "1" -- "0..*" 信用记录
用户 "1" -- "0..*" 批量申请
用户 "1" -- "0..*" 预约申请
用户 "1" -- "0..*" 违规记录
用户 "1" -- "0..*" 申诉

实验室 "1" -- "0..*" 工位
实验室 "1" -- "0..*" 设备
实验室 "1" -- "1..*" 开放时间规则
实验室 "1" -- "0..*" 实验室时段位图
工位 "1" -- "0..*" 工位时段位图
实验室 "1" -- "0..*" 批量申请
实验室 "1" -- "0..*" 统计指标

批量申请 "1" -- "0..*" 预约申请
预约申请 "1" -- "0..*" 座位分配
工位 "1" -- "0..*" 座位分配
预约申请 "1" -- "0..*" 违规记录
违规记录 "1" -- "0..*" 信用记录
违规记录 "1" -- "0..1" 申诉
预约申请 "1" -- "0..*" 排期结果
排期任务 "1" -- "0..*" 排期结果
排期任务 "1" -- "0..1" 算法实验

排期任务 ..> 排期引擎
排期引擎 ..> 适应度评估器
排期引擎 ..> 冲突检测器
冲突检测器 ..> 实验室时段位图
冲突检测器 ..> 工位时段位图
算法实验 ..> 评价器
签到服务 ..> 账号认证服务
签到服务 ..> 预约申请
签到服务 ..> 设备
用户 "1" -- "0..*" 对话线程
智能助手服务 ..> 账号认证服务 : 验证身份
智能助手服务 ..> 对话线程 : 隔离读写
智能助手服务 ..> 只读工具集 : 白名单调用
智能助手服务 ..> 预约草稿 : 生成与校验
只读工具集 ..> 实验室 : 只读规则与空闲
只读工具集 ..> 预约申请 : 只读本人记录

note bottom of 智能助手服务
  仅通过 Spring Boot 白名单只读接口获取数据。
  草稿由用户确认后进入原预约事务，AI 不直连业务数据库。
end note

note right of 实验室时段位图
  单个 48 位掩码运算为 O(1)。
  整室申请检查整室与全部工位掩码并集；
  工位申请先检查整室，再逐工位检测。
end note

note bottom of 预约申请
  FIXED：事务成功后直接已通过。
  SCHEDULABLE：提交时进入待排期，主方案发布时生效。
  每次状态迁移均写 t_reservation_log。
end note
@enduml
