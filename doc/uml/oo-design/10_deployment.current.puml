@startuml
' 现状源稿：当前可运行拓扑。不覆盖同目录 10_deployment.puml（图 4-7 目标部署，尚未按仓库落地）。
' 样式引用相对于 doc/uml/oo-design/。
' 已按代码核实。不含仓库中不存在的 Nginx、独立 :8081 Worker、mysqldump 节点。
!include ../_style.inc.puml
title 图4-7（现状稿）系统部署图——当前可运行拓扑

skinparam linetype ortho
skinparam nodesep 38
skinparam ranksep 55

node "学生手机" as C1 {
  artifact "微信原生小程序\n查询 / 预约 / 扫码签到签退\n直连 Spring Boot :8080" as MP
}

node "教师 / 管理员 / 学生电脑" as C2 {
  artifact "Vue3 Web :5173\n松风工作台顶栏壳层\n业务 /api 与 /api/ai 代理" as FE
}

node "实验室签到电脑" as C3 {
  artifact "Web 签到终端页 /terminal\n学号 + 密码，不建立管理会话" as CT
}

node "应用主机（本地或单机部署）" as APP {
  node "JDK 21 + Spring Boot 3.5 :8080" as SB {
    artifact "业务 API、鉴权、事务\n进程内 ScheduleWorker\n与预约/统计定时任务" as A1
  }
  node "Python 3.12 + Uvicorn :8000" as PY {
    artifact "ai-service\nFastAPI + LangChain\n只读工具 / 会话 / 草稿" as AI
  }
  database "MySQL 8\n本地默认 :3307" as DB {
    artifact "lab_reservation\nFlyway V1–V10" as D1
  }
  database "Redis\n:6379" as REDIS {
    artifact "resv:lab:{labId}:{date}\n签到限流与终端会话\nai:chat:{userId}:{threadId}" as R1
  }
}

node "可选外部服务" as EXT {
  artifact "微信登录接口\n（需 AppID / AppSecret）" as WX
  artifact "DeepSeek API\n（需 DEEPSEEK_API_KEY）" as MODEL
}

FE --> A1 : 开发期 Vite 代理 /api/**
FE --> AI : 开发期 Vite 代理 /api/ai/**
MP --> A1 : HTTP :8080 /api/**
CT --> A1 : /api/checkin/terminal/**
AI --> A1 : 内部令牌 + 用户 Bearer\n/api/internal/**
A1 --> DB : JDBC / HikariCP
A1 --> REDIS : Lettuce
AI --> REDIS : 对话历史
A1 --> WX : 可选
AI --> MODEL : 可选；未配置时普通预约不受影响

note bottom of A1
  排期计算与自动发布不在独立 :8081 进程。
  由 app.schedule.worker.enabled 等开关控制。
  生产库地址由 LAB_DB_URL 注入，不以 3306 为既成事实。
end note

note bottom of AI
  AI 不直连 MySQL，不直接写预约。
  草稿经用户确认后进入 POST /api/reservations。
end note
@enduml
