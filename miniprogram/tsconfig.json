{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["miniprogram-api-typings"]
  },
  "include": ["miniprogram/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
