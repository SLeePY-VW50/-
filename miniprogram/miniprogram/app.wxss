page { min-height: 100%; color: #1a1d1b; background: #f3f0ea; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei UI", sans-serif; font-size: 28rpx; }
view, text, input, textarea, button, picker { box-sizing: border-box; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 28rpx 28rpx 48rpx; }
.card { background: #fbfaf7; border: 2rpx solid #e4e0d8; border-radius: 12rpx; box-shadow: none; }
.button-primary { min-height: 88rpx; color: #fbfaf7; background: #1f6b57; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; line-height: 88rpx; }
.button-secondary { min-height: 72rpx; color: #4a524e; background: #fbfaf7; border: 2rpx solid #e4e0d8; border-radius: 12rpx; font-size: 26rpx; line-height: 70rpx; }
.muted { color: #656d67; }
.error { margin-bottom: 24rpx; padding: 24rpx; color: #9a3a30; background: #fdf6f5; border: 2rpx solid #efd0cb; border-radius: 12rpx; font-size: 26rpx; }
.loading, .empty { padding: 64rpx 24rpx; color: #656d67; text-align: center; }
