page { min-height: 100%; color: #171717; background: #e6e9ee; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
view, text, input, textarea, button, picker { box-sizing: border-box; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 24rpx 28rpx 48rpx; background: #ffffff; }
.card { background: #ffffff; border-bottom: 2rpx solid #ececec; border-radius: 0; box-shadow: none; }
.button-primary { min-height: 88rpx; color: #ffffff; background: #171717; border-radius: 0; font-size: 30rpx; font-weight: 500; line-height: 88rpx; }
.button-secondary { min-height: 72rpx; color: #525252; background: #ffffff; border: 2rpx solid #ececec; border-radius: 0; font-size: 26rpx; line-height: 70rpx; }
.muted { color: #525252; }
.error { margin-bottom: 24rpx; padding: 24rpx; color: #171717; background: #ffffff; border: 2rpx solid #ececec; border-radius: 0; font-size: 26rpx; }
.loading, .empty { padding: 48rpx 0; color: #525252; text-align: left; }
