<view class="page home">
  <view class="kicker">今日实验</view>
  <view class="headline">{{userName || 'LabSpace'}}</view>
  <view wx:if="{{error}}" class="error" aria-role="alert" aria-live="assertive">
    <text>{{error}}</text>
    <button class="retry" aria-label="重试加载首页预约" bindtap="load">重试</button>
  </view>
  <view wx:if="{{next}}" class="session">
    <view class="session__kicker">下一场预约</view>
    <view class="session__time">{{nextClock}}</view>
    <view class="session__lab">{{next.labName || '待分配实验室'}}</view>
    <view class="session__seat">{{next.date}} · {{nextStatus}} · {{nextPlace}}</view>
    <button class="button-primary scan-button" disabled="{{actionLoading}}" loading="{{actionLoading}}" aria-label="为下一场预约扫码签到" catchtap="scanNext">{{actionLoading ? '正在签到' : '扫码签到'}}</button>
    <view class="session__link" aria-role="button" aria-label="查看下一场预约详情" bindtap="openNext">查看详情</view>
  </view>
  <view wx:if="{{loading}}" class="loading" aria-live="polite">正在加载首页预约</view>
  <view wx:if="{{!next && !loading && !error}}" class="empty-session">
    <view class="empty-session__title">今天还没有下一场</view>
    <view class="muted">去时间尺选择开放时段。</view>
  </view>
  <view wx:if="{{recent.length}}" class="section-title">待排期</view>
  <view wx:for="{{recent}}" wx:key="resvId" class="later">
    <view class="later__top"><text>{{item.labName || '待排期分配'}}</text><text>{{item.statusText}}</text></view>
    <view class="muted">{{item.timeText}}</view>
  </view>
  <view class="links">
    <button class="link" bindtap="labs">时间尺<text>查看开放时段</text></button>
    <button class="link" bindtap="reservations">预约<text>详情、取消与签退</text></button>
    <button class="link" bindtap="profile">账号<text>身份与退出</text></button>
  </view>
</view>
