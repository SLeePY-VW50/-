.kicker { color: #1f6b57; font-size: 24rpx; font-weight: 600; }
.headline { margin: 8rpx 0 28rpx; font-size: 48rpx; font-weight: 700; letter-spacing: -1rpx; }
.retry { min-height: 96rpx; margin-top: 12rpx; padding: 0 28rpx; color: #9a3a30; background: #fbfaf7; border: 2rpx solid #efd0cb; border-radius: 12rpx; font-size: 26rpx; line-height: 96rpx; }
.session { padding: 8rpx 0 28rpx; border-bottom: 2rpx solid #e4e0d8; }
.session__kicker { color: #1f6b57; font-size: 24rpx; font-weight: 600; }
.session__time { margin-top: 8rpx; font-size: 72rpx; font-weight: 700; line-height: 1; letter-spacing: -1rpx; }
.session__lab { margin-top: 16rpx; font-size: 36rpx; font-weight: 650; }
.session__seat { margin: 8rpx 0 28rpx; color: #4a524e; font-size: 26rpx; }
.scan-button { min-height: 96rpx; line-height: 96rpx; }
.session__link { margin-top: 16rpx; color: #1f6b57; font-size: 26rpx; font-weight: 600; }
.empty-session { padding: 36rpx 0; border-bottom: 2rpx solid #e4e0d8; }
.empty-session__title { margin-bottom: 8rpx; font-size: 34rpx; font-weight: 700; }
.section-title { margin: 32rpx 0 8rpx; color: #656d67; font-size: 24rpx; font-weight: 650; }
.later { padding: 22rpx 0; border-bottom: 2rpx solid #e4e0d8; }
.later__top { display: flex; justify-content: space-between; gap: 16rpx; margin-bottom: 8rpx; font-weight: 600; }
.links { margin-top: 12rpx; }
.link { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 96rpx; margin: 0; padding: 20rpx 0; color: #1a1d1b; background: transparent; border-bottom: 2rpx solid #e4e0d8; text-align: left; font-size: 28rpx; font-weight: 650; line-height: 1.4; }
.link text { color: #656d67; font-size: 22rpx; font-weight: 400; }