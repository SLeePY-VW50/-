.kicker { color: #525252; font-size: 24rpx; font-weight: 400; }
.headline { margin: 8rpx 0 24rpx; font-size: 40rpx; font-weight: 600; }
.retry { min-height: 88rpx; margin-top: 12rpx; padding: 0 28rpx; color: #171717; background: #ffffff; border: 2rpx solid #ececec; font-size: 26rpx; line-height: 88rpx; }
.session { padding: 8rpx 0 24rpx; border-bottom: 2rpx solid #ececec; }
.session__kicker { color: #525252; font-size: 24rpx; }
.session__time { margin-top: 8rpx; font-size: 56rpx; font-weight: 600; line-height: 1; }
.session__lab { margin-top: 12rpx; font-size: 32rpx; font-weight: 500; }
.session__seat { margin: 8rpx 0 24rpx; color: #525252; font-size: 26rpx; }
.scan-button { min-height: 88rpx; line-height: 88rpx; }
.session__link { margin-top: 16rpx; color: #171717; font-size: 26rpx; text-decoration: underline; text-underline-offset: 6rpx; }
.empty-session { padding: 28rpx 0; border-bottom: 2rpx solid #ececec; }
.empty-session__title { margin-bottom: 8rpx; font-size: 32rpx; font-weight: 600; }
.section-title { margin: 28rpx 0 8rpx; color: #525252; font-size: 24rpx; }
.later { padding: 20rpx 0; border-bottom: 2rpx solid #ececec; }
.later__top { display: flex; justify-content: space-between; gap: 16rpx; margin-bottom: 8rpx; font-weight: 500; }
.links { margin-top: 8rpx; }
.link { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 88rpx; margin: 0; padding: 16rpx 0; color: #171717; background: transparent; border-bottom: 2rpx solid #ececec; text-align: left; font-size: 28rpx; font-weight: 500; line-height: 1.4; }
.link text { color: #737373; font-size: 22rpx; font-weight: 400; }
