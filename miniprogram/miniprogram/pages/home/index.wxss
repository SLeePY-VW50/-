.brand { display: flex; align-items: center; gap: 16rpx; }
.brand__mark { display: grid; width: 58rpx; height: 58rpx; color: #fff; background: #3867e8; border-radius: 16rpx; place-items: center; }
.brand__name { font-size: 34rpx; font-weight: 750; }
.greeting { margin-top: 34rpx; }
.headline { margin: 8rpx 0 28rpx; font-size: 44rpx; font-weight: 750; }
.retry { min-height: 96rpx; margin-top: 12rpx; padding: 0 28rpx; color: #b94451; background: #fff; font-size: 26rpx; line-height: 96rpx; }
.next-card { min-height: 96rpx; padding: 32rpx; color: #fff; background: #315fda; border-radius: 28rpx; }
.next-card__top { display: flex; justify-content: space-between; font-size: 24rpx; }
.next-card__lab { margin-top: 32rpx; font-size: 34rpx; font-weight: 700; }
.next-card__time { margin-top: 14rpx; }
.next-card__seat { margin: 12rpx 0 28rpx; color: #dce6ff; font-size: 24rpx; }
.scan-button { min-height: 96rpx; color: #274da9; background: #fff; border-radius: 16rpx; font-size: 26rpx; line-height: 96rpx; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin: 24rpx 0; }
.quick { min-height: 96rpx; margin: 0; padding: 24rpx; text-align: left; font-size: 27rpx; font-weight: 650; line-height: 1.4; }
.quick text { display: block; margin-top: 10rpx; color: #77849a; font-size: 21rpx; font-weight: 400; }
.section-title { margin: 30rpx 0 16rpx; font-weight: 650; }
.recent { margin-bottom: 14rpx; padding: 24rpx; }
.recent > view:first-child { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
