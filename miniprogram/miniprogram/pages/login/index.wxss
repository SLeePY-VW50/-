.auth-page { display: flex; flex-direction: column; justify-content: center; min-height: 100vh; padding: 48rpx 40rpx 64rpx; background: #ffffff; }
.auth-center { width: 100%; }
.auth-brand__name { font-size: 32rpx; font-weight: 600; }
.kicker { margin-top: 36rpx; color: #525252; font-size: 24rpx; }
.auth-title { margin-top: 8rpx; font-size: 56rpx; font-weight: 600; line-height: 1.15; }
.auth-subtitle { margin: 12rpx 0 28rpx; color: #525252; }
.motif { display: grid; gap: 8rpx; margin-bottom: 32rpx; }
.motif__row { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4rpx; }
.motif__cell { height: 16rpx; background: #ffffff; border-bottom: 2rpx solid #ececec; }
.motif__cell.on { background: repeating-linear-gradient(-45deg, #f5f5f5 0 4rpx, #dddddd 4rpx 6rpx); }
.development { margin-top: 32rpx; padding-top: 24rpx; border-top: 2rpx solid #ececec; }
.development__title { font-weight: 500; }
.development__note { margin: 8rpx 0 20rpx; font-size: 24rpx; }
.auth-label { display: block; margin: 0 0 8rpx; color: #525252; }
.auth-input { height: 96rpx; margin-bottom: 16rpx; padding: 0 20rpx; color: #171717; background: #ffffff; border: 2rpx solid #ececec; }
.password-field { display: flex; align-items: flex-start; gap: 12rpx; }
.password-field .auth-input { flex: 1; min-width: 0; }
.password-toggle { width: 144rpx; padding: 0 12rpx; color: #525252; background: #ffffff; border: 2rpx solid #ececec; font-size: 26rpx; }
.auth-page .button-primary, .auth-page .button-secondary, .password-toggle { min-height: 96rpx; line-height: 96rpx; }
