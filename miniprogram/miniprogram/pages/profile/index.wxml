<view class="page">
  <view class="page-title">我的</view>
  <view wx:if="{{user}}" class="card profile">
    <view class="avatar">{{user.name[0]}}</view>
    <view>
      <view class="profile__name">{{user.name}}</view>
      <view class="muted">{{user.account}} · {{roleText}}</view>
      <view wx:if="{{development}}" class="muted development-note">当前为开发登录环境</view>
    </view>
  </view>
  <view wx:else class="empty">暂无可显示的用户信息</view>
  <button class="card profile-link" bindtap="reservations">我的预约<text>›</text></button>
  <button class="button-secondary logout" bindtap="logout">退出登录</button>
</view>
