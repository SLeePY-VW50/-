.page-title { margin-bottom: 24rpx; font-size: 40rpx; font-weight: 700; }
.profile { display: flex; align-items: center; gap: 24rpx; padding: 32rpx; }
.avatar { display: grid; flex-shrink: 0; width: 84rpx; height: 84rpx; color: #3867e8; background: #eaf0ff; border-radius: 50%; place-items: center; font-size: 32rpx; }
.profile__name { margin-bottom: 10rpx; font-size: 34rpx; font-weight: 700; }
.development-note { margin-top: 8rpx; font-size: 22rpx; }
.profile-link { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 96rpx; margin-top: 24rpx; padding: 28rpx; text-align: left; line-height: 1.4; }
.logout { min-height: 96rpx; margin-top: 36rpx; line-height: 94rpx; }
