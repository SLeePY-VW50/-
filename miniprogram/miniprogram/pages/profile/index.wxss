.page-title { margin-bottom: 24rpx; font-size: 36rpx; font-weight: 600; }
.profile { display: flex; align-items: center; gap: 24rpx; padding: 8rpx 0 28rpx; border-bottom: 2rpx solid #ececec; }
.avatar { display: none; }
.profile__name { margin-bottom: 8rpx; font-size: 32rpx; font-weight: 600; }
.development-note { margin-top: 8rpx; font-size: 22rpx; }
.profile-link { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 96rpx; margin-top: 8rpx; padding: 24rpx 0; text-align: left; line-height: 1.4; background: transparent; border-bottom: 2rpx solid #ececec; }
.logout { min-height: 96rpx; margin-top: 32rpx; line-height: 94rpx; }
