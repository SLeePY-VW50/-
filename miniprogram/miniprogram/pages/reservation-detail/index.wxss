.detail { padding: 30rpx; }
.detail__head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-weight: 650; }
.detail-row { display: flex; min-height: 96rpx; padding: 20rpx 0; align-items: center; justify-content: space-between; gap: 28rpx; border-bottom: 2rpx solid #ececec; }
.detail-row text:last-child { text-align: right; }
.status { flex-shrink: 0; color: #525252; font-size: 24rpx; }
.status--PENDING_SCHEDULE { color: #525252; }
.status--APPROVED, .status--IN_USE { color: #171717; font-weight: 500; }
.status--NO_SHOW, .status--VIOLATION_TERMINATED { color: #171717; font-weight: 600; }
.actions { margin-top: 24rpx; }
.actions button { min-height: 96rpx; margin-bottom: 16rpx; line-height: 96rpx; }
