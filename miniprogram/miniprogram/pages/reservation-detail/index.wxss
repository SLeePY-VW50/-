.detail { padding: 30rpx; }
.detail__head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-weight: 650; }
.detail-row { display: flex; min-height: 96rpx; padding: 20rpx 0; align-items: center; justify-content: space-between; gap: 28rpx; border-bottom: 2rpx solid #edf0f5; }
.detail-row text:last-child { text-align: right; }
.status { flex-shrink: 0; padding: 8rpx 16rpx; color: #627089; background: #f1f3f6; border-radius: 30rpx; font-size: 21rpx; }
.status--PENDING_SCHEDULE { color: #93620c; background: #fff7df; }
.status--APPROVED, .status--IN_USE { color: #108260; background: #eaf8f2; }
.status--NO_SHOW, .status--VIOLATION_TERMINATED { color: #c65361; background: #fff0f1; }
.actions { margin-top: 24rpx; }
.actions button { min-height: 96rpx; margin-bottom: 16rpx; line-height: 96rpx; }
