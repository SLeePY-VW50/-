.page-title { font-size: 40rpx; font-weight: 700; }
.page-subtitle { margin: 10rpx 0 28rpx; }
.form-card { padding: 26rpx; }
.segment { display: flex; margin-bottom: 22rpx; padding: 6rpx; background: #e9edf4; border-radius: 14rpx; }
.segment text { display: flex; flex: 1; min-width: 96rpx; min-height: 96rpx; padding: 12rpx 24rpx; color: #77849a; text-align: center; align-items: center; justify-content: center; }
.segment .active { color: #3867e8; background: #fff; border-radius: 10rpx; font-weight: 700; }
.form-row { display: flex; min-height: 96rpx; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 2rpx solid #edf0f5; }
.field-label { flex-shrink: 0; font-weight: 600; }
.form-input { flex: 1; min-height: 96rpx; text-align: right; }
.form-note { margin: 10rpx 0 20rpx; font-size: 23rpx; }
.purpose-label { display: block; margin-top: 24rpx; }
.purpose { width: 100%; min-height: 160rpx; margin-top: 12rpx; padding: 20rpx; background: #f8faff; border-radius: 14rpx; }
.error { margin-top: 24rpx; }
.success { margin: 24rpx 0 20rpx; padding: 22rpx; color: #107c5c; background: #edf8f4; border-radius: 14rpx; }
.submit-button { min-height: 96rpx; margin-top: 24rpx; line-height: 96rpx; }
