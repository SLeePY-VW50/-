<view class="page board">
  <view class="muted page-subtitle">按节预约，一节一格</view>
  <view wx:if="{{error}}" class="error">
    <text>{{error}}</text>
    <text bindtap="retry" class="retry" role="button">重试</text>
  </view>
  <picker range="{{labNames}}" value="{{labIndex}}" disabled="{{!labNames.length}}" aria-label="选择实验室" bindchange="onLab">
    <view class="picker-row">
      <text>{{labNames[labIndex] || '暂无实验室'}}</text>
      <text class="muted">更换</text>
    </view>
  </picker>
  <view class="filters">
    <picker mode="date" value="{{date}}" aria-label="选择预约日期" bindchange="onDate">
      <view class="filter-value"><text class="filter-label">预约日期</text>{{date}}</view>
    </picker>
    <view class="segment" aria-label="预约方式">
      <text class="{{mode === 'ROOM' ? 'active' : ''}}" aria-selected="{{mode === 'ROOM'}}" data-mode="ROOM" bindtap="onMode">整室</text>
      <text class="{{mode === 'SEAT' ? 'active' : ''}}" aria-selected="{{mode === 'SEAT'}}" data-mode="SEAT" bindtap="onMode">工位</text>
    </view>
  </view>
  <view wx:if="{{loading}}" class="loading">正在读取开放规则与占用情况</view>
  <block wx:elif="{{availability}}">
    <slot-grid wx:if="{{dayRule && availability.slots.length}}" slots="{{availability.slots}}" mode="{{mode}}" openTime="{{openTime}}" closeTime="{{closeTime}}" date="{{date}}" selection="{{selection}}" bind:change="onSelection" />
    <view wx:elif="{{dayRule}}" class="empty">当日暂无可显示的时间片</view>
    <view wx:if="{{dayRule}}" class="muted rule-note">开放第 {{dayRule.openStartPeriod}}–{{dayRule.openEndPeriod}} 节 · 每次 {{dayRule.minPeriods}}–{{dayRule.maxPeriods}} 节 · 提前 {{dayRule.advanceMinDays}}–{{dayRule.advanceMaxDays}} 天</view>
    <view wx:else class="empty">当日未开放</view>
  </block>
  <view wx:elif="{{!error && !labs.length}}" class="empty">暂无可预约实验室</view>
  <view class="recommend-box">
    <picker range="{{durationOptions}}" value="{{durationIndex}}" aria-label="预约时长" bindchange="onDuration">
      <view class="form-row"><text class="field-label">时长</text><text>{{durationMinutes}} 分钟</text></view>
    </picker>
    <view class="form-row">
      <label class="field-label" for="party-size">人数</label>
      <input id="party-size" class="form-input" type="number" value="{{attendeeCount}}" bindinput="onAttendees" />
    </view>
    <button class="button-secondary" loading="{{recommending}}" disabled="{{recommending}}" bindtap="loadRecommendations">推荐空闲时段</button>
    <view wx:if="{{recommendationNote}}" class="muted rule-note">{{recommendationNote}}</view>
    <view wx:if="{{recommendations.length}}" class="candidates">
      <view wx:for="{{recommendations}}" wx:key="startSlot" class="candidate" data-index="{{index}}" bindtap="useRecommendation">{{item.startTime}}–{{item.endTime}}</view>
    </view>
  </view>
  <view wx:if="{{selectedText}}" class="selection-bar">
    <view>
      <text class="muted">已选时段</text>
      <view>{{selectedText}}</view>
    </view>
    <button class="button-primary" bindtap="goReserve">去预约</button>
  </view>
</view>
