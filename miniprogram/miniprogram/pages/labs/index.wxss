.page { padding-left: 0; padding-right: 0; }
.page-title, .page-subtitle, .picker-row, .filters, .rule-note, .error, .loading, .empty, .selection-bar { margin-left: 28rpx; margin-right: 28rpx; }
.page-title { font-size: 36rpx; font-weight: 600; }
.page-subtitle { margin: 8rpx 28rpx 16rpx; color: #525252; font-size: 24rpx; }
.picker-row { display: flex; min-height: 88rpx; padding: 8rpx 0; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #ececec; font-weight: 500; }
.filters { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; margin-bottom: 16rpx; padding: 8rpx 0; border-bottom: 2rpx solid #ececec; }
.filter-value { display: flex; min-height: 88rpx; color: #171717; align-items: center; }
.filter-label { margin-right: 16rpx; color: #525252; }
.segment { display: flex; border: 2rpx solid #ececec; }
.segment text { display: flex; min-width: 96rpx; min-height: 64rpx; padding: 8rpx 20rpx; color: #525252; align-items: center; justify-content: center; }
.segment .active { color: #ffffff; background: #171717; font-weight: 500; }
.rule-note { margin-top: 16rpx; margin-bottom: 16rpx; color: #525252; font-size: 24rpx; line-height: 1.6; }
.selection-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 16rpx 0; border-top: 2rpx solid #ececec; }
.selection-bar .button-primary { min-height: 88rpx; margin: 0; padding: 0 28rpx; line-height: 88rpx; }
.retry { display: inline-flex; min-width: 96rpx; min-height: 88rpx; margin-left: 16rpx; align-items: center; justify-content: center; text-decoration: underline; }
