.page-title { font-size: 44rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.page-subtitle { margin: 8rpx 0 20rpx; }
.picker-row { display: flex; min-height: 96rpx; padding: 8rpx 0; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #e4e0d8; font-weight: 650; }
.filters { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0 20rpx; padding: 8rpx 0; border-bottom: 2rpx solid #e4e0d8; }
.filter-value { display: flex; min-height: 96rpx; color: #1a1d1b; align-items: center; }
.filter-label { margin-right: 16rpx; color: #4a524e; }
.segment { display: flex; padding: 6rpx; background: #efece6; border-radius: 12rpx; }
.segment text { display: flex; min-width: 96rpx; min-height: 96rpx; padding: 12rpx 24rpx; color: #656d67; align-items: center; justify-content: center; }
.segment .active { color: #1f6b57; background: #fbfaf7; border-radius: 8rpx; font-weight: 700; }
.rule-note { margin: 8rpx 0 24rpx; font-size: 23rpx; line-height: 1.7; }
.selection-bar { position: sticky; bottom: 16rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; padding: 16rpx 20rpx; background: #e7f3ee; border: 2rpx solid #c9e3d8; border-radius: 12rpx; }
.selection-bar .button-primary { min-height: 96rpx; margin: 0; padding: 0 28rpx; line-height: 96rpx; }
.retry { display: inline-flex; min-width: 96rpx; min-height: 96rpx; margin-left: 16rpx; align-items: center; justify-content: center; text-decoration: underline; }
