.slot-band { margin-bottom: 22rpx; }
.slot-band__label { display: flex; justify-content: space-between; margin-bottom: 10rpx; color: #656d67; font-size: 22rpx; }
.slot-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8rpx; }
.slot { display: flex; min-height: 88rpx; padding: 10rpx 4rpx; color: #4a524e; background: #fbfaf7; border: 2rpx solid #e4e0d8; border-radius: 8rpx; align-items: center; justify-content: center; flex-direction: column; font-size: 20rpx; }
.slot__meta { margin-top: 4rpx; color: #1f6b57; font-size: 18rpx; }
.slot--closed { color: #656d67; background: #efece6; }
.slot--closed .slot__meta { color: #656d67; }
.slot--disabled { color: #656d67; background: #f3f0ea; }
.slot--disabled .slot__meta { color: #656d67; }
.slot--selected { color: #fbfaf7; background: #1f6b57; border-color: #1f6b57; }
.slot--selected .slot__meta { color: #fbfaf7; }
