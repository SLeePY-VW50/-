.legend { display: flex; gap: 28rpx; margin-bottom: 16rpx; color: #4a524e; font-size: 22rpx; }
.legend text { display: flex; align-items: center; }
.legend text::before { width: 22rpx; height: 22rpx; margin-right: 8rpx; border: 2rpx solid #e4e0d8; border-radius: 4rpx; content: ''; }
.legend__open::before { background: #fbfaf7; box-shadow: inset 0 -6rpx 0 #1f6b57; }
.legend__busy::before { background: repeating-linear-gradient(135deg, #e7e2d8 0 4rpx, #cfc8bc 4rpx 8rpx); border-color: #cfc8bc; }
.legend__pick::before { background: #1f6b57; border-color: #1f6b57; }
.slot-band { margin-bottom: 18rpx; }
.slot-band__label { display: flex; justify-content: space-between; margin-bottom: 8rpx; color: #656d67; font-size: 22rpx; }
.slot-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8rpx; }
.slot { display: flex; min-height: 76rpx; padding: 8rpx 2rpx; color: #1a1d1b; background: #fbfaf7; border: 2rpx solid #e4e0d8; border-bottom: 6rpx solid #1f6b57; border-radius: 8rpx; align-items: center; justify-content: center; flex-direction: column; font-size: 22rpx; }
.slot--hour { font-weight: 700; }
.slot__meta { margin-top: 2rpx; color: #8a5a12; font-size: 18rpx; font-weight: 600; }
.slot--closed { color: #656d67; background: #efece6; border-color: #e4e0d8; border-bottom-color: #d5d0c6; font-weight: 400; }
.slot--disabled { color: #4a524e; background: repeating-linear-gradient(135deg, #e7e2d8 0 6rpx, #cfc8bc 6rpx 12rpx); border-color: #cfc8bc; border-bottom-color: #8a8378; }
.slot--disabled .slot__meta { color: #1a1d1b; }
.slot--selected { color: #fbfaf7; background: #1f6b57; border-color: #185546; border-bottom-color: #14382e; }
.slot--selected .slot__meta { color: #fbfaf7; }
