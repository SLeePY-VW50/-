.periods { display: flex; min-height: 920rpx; background: #ffffff; border-top: 2rpx solid #ececec; }
.period { position: relative; flex: 1; display: flex; flex-direction: column; min-width: 0; border-left: 2rpx solid #ececec; }
.period:first-child { border-left: 0; }
.period-h { height: 72rpx; padding: 8rpx 8rpx 0; border-bottom: 2rpx solid #ececec; }
.period-h__name { display: block; color: #171717; font-size: 22rpx; font-weight: 500; line-height: 1.2; }
.period-h__range { display: block; color: #737373; font-size: 18rpx; line-height: 1.2; }
.slots { position: relative; flex: 1; display: flex; flex-direction: column; }
.cell { flex: 1; display: flex; align-items: center; justify-content: space-between; min-height: 44rpx; padding: 0 8rpx; color: #525252; background: #ffffff; border-bottom: 2rpx solid #ececec; font-size: 18rpx; }
.cell--closed { color: transparent; background: repeating-linear-gradient(-45deg, #f5f5f5 0 6rpx, #dddddd 6rpx 8rpx); }
.cell--occupied { color: #171717; background: repeating-linear-gradient(-45deg, #ffffff 0 6rpx, #525252 6rpx 8rpx); }
.cell--selected { color: #ffffff; background: #171717; }
.cell__count { font-size: 18rpx; }
.now-line { position: absolute; left: 0; right: 0; z-index: 3; border-top: 2rpx solid #171717; pointer-events: none; }
.now-line text { position: absolute; left: 0; top: -14rpx; padding: 0 6rpx; color: #ffffff; background: #171717; font-size: 18rpx; line-height: 28rpx; }
