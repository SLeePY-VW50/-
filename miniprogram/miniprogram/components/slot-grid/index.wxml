<wxs module="board">
var NAMES = ['凌晨', '上午', '下午', '晚间']
var RANGES = ['00:00–06:00', '06:00–12:00', '12:00–18:00', '18:00–24:00']
function minute(value, end) {
  if (!value) return 0
  if (end && value.indexOf('24:00') === 0) return 1440
  var parts = value.split(':')
  var hour = parseInt(parts[0], 10)
  var mins = parseInt(parts[1] || '0', 10)
  if (isNaN(hour)) hour = 0
  if (isNaN(mins)) mins = 0
  return hour * 60 + mins
}
function group(slots) {
  var rows = []
  if (!slots || !slots.length) return rows
  var count = Math.ceil(slots.length / 12)
  var row = 0
  for (row = 0; row < count; row++) {
    var items = []
    var start = row * 12
    var end = start + 12
    if (end > slots.length) end = slots.length
    var i = start
    for (i = start; i < end; i++) items.push(slots[i])
    rows.push({ name: NAMES[row] || '', range: RANGES[row] || ('' + row), slots: items })
  }
  return rows
}
function closed(index, openTime, closeTime) {
  var start = minute(openTime, false)
  var end = minute(closeTime, true)
  return index * 30 < start || (index + 1) * 30 > end
}
function used(slot) {
  var total = slot.occupiedSeatCount + slot.availableSeatCount
  if (total <= 0) return slot.availableSeatCount === 0 ? 100 : 0
  return Math.round(slot.occupiedSeatCount * 100 / total)
}
function mark(slot, selection) {
  if (selection && selection.end === slot.index) return '终点'
  if (selection && selection.start === slot.index) return '起点'
  return ''
}
module.exports.group = group
module.exports.closed = closed
module.exports.used = used
module.exports.mark = mark
</wxs>
<view class="periods">
  <view wx:for="{{board.group(slots)}}" wx:for-item="band" wx:for-index="pi" wx:key="range" class="period">
    <view class="period-h"><text class="period-h__name">{{band.name}}</text><text class="period-h__range">{{band.range}}</text></view>
    <view class="slots">
      <view wx:for="{{band.slots}}" wx:for-item="slot" wx:key="index" class="cell {{slot.index % 2 === 0 ? 'cell--hour' : ''}} {{selection && slot.index >= selection.start && (selection.end === null ? slot.index === selection.start : slot.index <= selection.end) ? 'cell--selected' : ''}} {{slot.roomOccupied && mode === 'ROOM' || slot.availableSeatCount === 0 && mode === 'SEAT' ? 'cell--occupied' : ''}} {{board.closed(slot.index, openTime, closeTime) ? 'cell--closed' : ''}}" data-index="{{slot.index}}" bindtap="select">
        <text wx:if="{{!board.closed(slot.index, openTime, closeTime)}}">{{slot.start}}</text>
        <text wx:if="{{mode === 'SEAT' && !board.closed(slot.index, openTime, closeTime) && slot.availableSeatCount > 0}}" class="cell__count">{{slot.availableSeatCount}}</text>
      </view>
      <view wx:if="{{pi === nowPeriod}}" class="now-line" style="top: {{nowTop}};"><text>{{nowLabel}}</text></view>
    </view>
  </view>
</view>
