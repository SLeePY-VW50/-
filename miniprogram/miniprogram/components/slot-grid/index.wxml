<wxs module="board">
var NAMES = { MORNING: '上午', AFTERNOON: '下午', EVENING: '晚上' }
var ORDER = ['MORNING', 'AFTERNOON', 'EVENING']
function group(slots) {
  var rows = []
  if (!slots || !slots.length) return rows
  var i = 0
  for (i = 0; i < ORDER.length; i++) {
    var items = []
    var j = 0
    for (j = 0; j < slots.length; j++) {
      if (slots[j].session === ORDER[i]) items.push(slots[j])
    }
    if (!items.length) continue
    rows.push({
      name: NAMES[ORDER[i]] || ORDER[i],
      range: items[0].start + '–' + items[items.length - 1].end,
      slots: items,
    })
  }
  return rows
}
function closed(slot) {
  return !slot || slot.bookable === false
}
function used(slot) {
  var total = slot.occupiedSeatCount + slot.availableSeatCount
  if (total <= 0) return slot.availableSeatCount === 0 ? 100 : 0
  return Math.round(slot.occupiedSeatCount * 100 / total)
}
function mark(slot, selection) {
  if (selection && selection.end === slot.index) return '终点'
  if (selection && selection.start === slot.index) return '起点'
  return ''
}
function hit(list, index) {
  if (!list || !list.length) return false
  var i = 0
  for (i = 0; i < list.length; i++) {
    if (list[i] === index) return true
  }
  return false
}
module.exports.group = group
module.exports.closed = closed
module.exports.used = used
module.exports.mark = mark
module.exports.hit = hit
</wxs>
<view class="periods">
  <view wx:for="{{board.group(slots)}}" wx:for-item="band" wx:for-index="pi" wx:key="range" class="period">
    <view class="period-h"><text class="period-h__name">{{band.name}}</text><text class="period-h__range">{{band.range}}</text></view>
    <view class="slots">
      <view wx:for="{{band.slots}}" wx:for-item="slot" wx:key="index" class="cell {{selection && slot.index >= selection.start && (selection.end === null ? slot.index === selection.start : slot.index <= selection.end) ? 'cell--selected' : ''}} {{slot.roomOccupied && mode === 'ROOM' || slot.availableSeatCount === 0 && mode === 'SEAT' ? 'cell--occupied' : ''}} {{board.closed(slot) ? 'cell--closed' : ''}} {{board.hit(conflict, slot.index) ? 'cell--conflict' : ''}}" hover-class="cell--pressed" hover-stay-time="80" data-index="{{slot.index}}" bindtap="select">
        <text>第{{slot.periodNo}}节 {{slot.start}}</text>
        <text wx:if="{{mode === 'SEAT' && !board.closed(slot) && slot.availableSeatCount > 0}}" class="cell__count">{{slot.availableSeatCount}}</text>
      </view>
      <view wx:if="{{pi === nowPeriod}}" class="now-line" style="top: {{nowTop}};"><text>{{nowLabel}}</text></view>
    </view>
  </view>
</view>
