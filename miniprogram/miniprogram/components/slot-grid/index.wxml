<view class="slot-grid"><view wx:for="{{slots}}" wx:for-item="slot" wx:key="index" class="slot {{selection && index >= selection.start && (selection.end === null ? index === selection.start : index <= selection.end) ? 'slot--selected' : ''}} {{slot.roomOccupied && mode === 'ROOM' || slot.availableSeatCount === 0 && mode === 'SEAT' ? 'slot--disabled' : ''}}" data-index="{{slot.index}}" bindtap="select"><text>{{slot.start}}</text><text class="slot__meta">{{selection && selection.start === index ? '起点' : selection && selection.end === index ? '终点' : mode === 'ROOM' ? slot.roomOccupied ? '已占用' : '可预约' : slot.availableSeatCount + ' 位'}}</text></view></view>
